{
  "name": "samurai",
  "version": "0.1.0",
  "homepage": "https://Maycon-MB.github.io/frontend-qualidade-SMRE",
  "private": true,
  "dependencies": {
    "@hookform/resolvers": "^2.9.10",
    "@testing-library/jest-dom": "^5.16.4",
    "@testing-library/react": "^13.2.0",
    "@testing-library/user-event": "^13.5.0",
    "axios": "^1.1.3",
    "bootstrap": "^5.2.3",
    "lucide-react": "^1.17.0",
    "react": "^18.1.0",
    "react-bootstrap": "^2.7.2",
    "react-dom": "^18.1.0",
    "react-hook-form": "^7.38.0",
    "react-pdf": "^10.4.1",
    "react-router-dom": "^6.3.0",
    "react-scripts": "5.0.1",
    "react-toastify": "^9.0.8",
    "web-vitals": "^2.1.4",
    "yup": "^0.32.11"
  },
  "scripts": {
    "start": "react-scripts start",
    "build": "cross-env GENERATE_SOURCEMAP=false react-scripts build",
    "test": "react-scripts test",
    "eject": "react-scripts eject",
    "predeploy": "cross-env REACT_APP_FASE=producao GENERATE_SOURCEMAP=false react-scripts build",
    "deploy": "gh-pages -d build --add",
    "build:beta": "cross-env PUBLIC_URL=/frontend-qualidade-SMRE/beta GENERATE_SOURCEMAP=false react-scripts build",
    "deploy:beta": "npm run build:beta && gh-pages -d build -e beta",
    "build:tutorial-termo": "cross-env REACT_APP_ALVO=tutorial-termo PUBLIC_URL=/frontend-qualidade-SMRE/tutorial-termo GENERATE_SOURCEMAP=false react-scripts build",
    "deploy:tutorial-termo": "npm run build:tutorial-termo && gh-pages -d build -e tutorial-termo",
    "start:tutorial-helpdesk": "cross-env REACT_APP_ALVO=tutorial-helpdesk react-scripts start",
    "build:tutorial-helpdesk": "cross-env REACT_APP_ALVO=tutorial-helpdesk PUBLIC_URL=/frontend-qualidade-SMRE/tutorial-helpdesk GENERATE_SOURCEMAP=false react-scripts build",
    "deploy:tutorial-helpdesk": "npm run build:tutorial-helpdesk && gh-pages -d build -e tutorial-helpdesk",
    "start:tutorial-analise-desligamento": "cross-env REACT_APP_ALVO=tutorial-analise-desligamento react-scripts start",
    "build:tutorial-analise-desligamento": "cross-env REACT_APP_ALVO=tutorial-analise-desligamento PUBLIC_URL=/frontend-qualidade-SMRE/tutorial-analise-desligamento GENERATE_SOURCEMAP=false react-scripts build",
    "deploy:tutorial-analise-desligamento": "npm run build:tutorial-analise-desligamento && gh-pages -d build -e tutorial-analise-desligamento"
  },
  "eslintConfig": {
    "extends": [
      "react-app",
      "react-app/jest"
    ]
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "devDependencies": {
    "cross-env": "^10.1.0",
    "gh-pages": "^6.3.0"
  }
}
